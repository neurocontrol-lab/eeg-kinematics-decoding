# Preserve recorded source/report byte hashes across Windows and WSL checkouts.
*.py text eol=lf
*.json text eol=lf
*.ipynb text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.mjs text eol=lf
outputs/**/declared_protocol.md text eol=lf

# Preserve exact CSV bytes recorded by R6 artifact manifests.
/outputs/error-dynamics-*/*.csv -text

# Preserve exact population timing tables.
/outputs/timing-alignment-population-*/*.csv -text

# Preserve EEG-history tables recorded by the summary receipt.
/outputs/history-duration-*/*.csv -text

# Preserve the byte hashes of executed Windows snapshots.
/outputs/position-velocity-p1-p12-20261110T171409Z/declared_protocol.md -text
